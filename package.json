{
  "name": "developer-integration-portal",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "engines": { "node": ">=20" },
  "workspaces": [
    "api",
    "web",
    "packages/sdk"
  ],
  "scripts": {
    "dev": "run-p -l api:dev web:dev",
    "api:dev": "npm run -w api dev",
    "web:dev": "npm run -w web dev",
    "build": "npm run -ws build",
    "test": "npm run -ws test --if-present",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "format": "prettier -w ."
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.3.3"
  }
}
